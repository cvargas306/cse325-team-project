@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using MyFavesApp.Services
@inject WatchlistService Watchlist
@inject AuthenticationStateProvider AuthStateProvider

<div class="sidebar-shell">
    <!-- Brand Header (reusing your existing component) -->
    <div class="sidebar-brand">
        <BrandHeader />
    </div>

    <!-- Mobile Hamburger Toggler (Real inline SVG, zero data-URI CSS) -->
    <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" aria-label="Toggle navigation" />
    <label for="nav-toggle" class="navbar-toggler" title="Navigation menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#28232B" stroke-width="2.2"
             stroke-linecap="round" aria-hidden="true">
            <line x1="4" y1="6" x2="20" y2="6" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="18" x2="20" y2="18" />
        </svg>
    </label>


    <!-- Navigation & Watchlists -->
    <div class="nav-scrollable" onclick="document.getElementById('nav-toggle').click()">
        <div class="sidebar-body">
            <!-- Primary Links -->
            <nav class="nav flex-column gap-2">
                <AuthorizeView>
                    <Authorized>
                        <NavLink class="figma-nav-link" href="" Match="NavLinkMatch.All">
                            <img src="images/icons/layout-grid.svg" alt="" class="icon-badge" />
                            <span>My Faves Hub</span>
                        </NavLink>

                        <NavLink class="figma-nav-link" href="search">
                            <img src="images/icons/search.svg" alt="" class="icon-badge" />
                            <span>Search movies</span>
                        </NavLink>
                    </Authorized>
                </AuthorizeView>                
            </nav>

            <AuthorizeView>
    <Authorized>
        <!-- Your Watchlists -->
        <div class="watchlists-section">
            <div class="d-flex justify-content-between align-items-center px-2">
                <span class="section-label">YOUR WATCHLISTS</span>
                <a href="watchlists" class="btn btn-link p-0 text-decoration-none watchlist-add-icon"
                   title="Create watchlist">
                    <img src="images/icons/plus-2.svg" alt="" class="icon-badge" />
                </a>
            </div>

            <div class="d-flex flex-column gap-1">
                <NavLink class="figma-nav-link" href="watchlist" Match="NavLinkMatch.All">
                    <img src="images/icons/star.svg" alt="" class="icon-badge" />
                    <span>My Favorites</span>
                </NavLink>

                @foreach (var list in myLists)
                {
                    <NavLink class="figma-nav-link" href="@($"watchlists/{list.Id}")">
                        <img src="images/icons/users.svg" alt="" class="icon-badge" />
                        <span class="flex-grow-1 text-truncate">@list.Name</span>
                        <span class="watchlist-count">@list.MovieCount</span>
                    </NavLink>
                }
            </div>
        </div>
    </Authorized>
</AuthorizeView>   

            <!-- Philosophy Callout Card -->
            <div class="collection-callout d-none d-sm-flex">
                <img src="images/icons/heart.svg" alt="" class="icon-badge" />
                <div class="callout-title">Your taste. Your collection.</div>
                <p class="callout-desc mb-0">Only the movies you choose. No recommendations, no noise.</p>
            </div>

            <!-- Bottom Help Link -->
            <div class="mt-auto">
                <a href="help" class="help-link text-decoration-none">
                    <img src="images/icons/circle-help.svg" alt="" class="icon-badge" />
                    <span>Help &amp; feedback</span>
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private List<WatchlistSummary> myLists = [];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (userId is not null)
            myLists = await Watchlist.GetListsAsync(userId);
    }
}